{
	"name": "rikardekstam-site",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev --host 0.0.0.0",
		"build": "astro check && astro build",
		"preview": "astro preview --host 0.0.0.0",
		"test": "node --test --test-isolation=none tests/*.test.mjs",
		"verify": "npm run check && npm run build && npm test",
		"test:browser": "playwright test",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check ."
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.5",
		"@fontsource/barlow-condensed": "^5.3.0",
		"@fontsource/dm-sans": "^5.3.0",
		"astro": "^7.4.12",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "^1.65.1"
	}
}
