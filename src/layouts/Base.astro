---
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700-italic.css";
import "@fontsource/barlow-condensed/800-italic.css";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "../styles/global.css";
import "../styles/reference.css";
import { site } from "../config";
import { publishedContent } from "../lib/content";
import Stripes from "../components/Stripes.astro";
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  date?: Date;
  noindex?: boolean;
}
const {
  title,
  description = site.description,
  article = false,
  date,
  noindex = false,
} = Astro.props;
const { projects, journal, updates } = await publishedContent();
const hasFeed = journal.length + updates.length > 0;
const path = Astro.url.pathname;
const pageTitle = title ? `${title} — Rikard Ekstam` : site.title;
const canonical = new URL(path, Astro.site);
const nav = [
  { href: "/", label: "Home" },
  ...(projects.length
    ? [{ href: "/projects/", label: "Projects" }]
    : site.designPreview
      ? [{ href: "/#projects", label: "Projects" }]
      : []),
  ...(journal.length
    ? [{ href: "/journal/", label: "Journal" }]
    : site.designPreview
      ? [{ href: "/#updates", label: "Journal" }]
      : []),
  ...(site.designPreview
    ? [{ href: "/#companies", label: "Companies & IP" }]
    : [{ href: "/now/", label: "Now" }]),
  { href: "/about/", label: "About" },
  { href: "/about/#contact", label: "Contact" },
];
---

<!-- Shared page metadata and navigation; individual pages provide the main content. -->
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#191a18" />
    <meta
      name="robots"
      content={site.indexable && !noindex ? "index, follow" : "noindex, nofollow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/images/social.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rikard Ekstam. I build stuff. In progress." />
    <meta name="twitter:card" content="summary_large_image" />
    {article && date && <meta property="article:published_time" content={date.toISOString()} />}
    {hasFeed && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title="Rikard Ekstam — updates"
        href="/rss.xml"
      />
    )}
  </head>
  <body class:list={{ "reference-home": path === "/" }}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="Rikard Ekstam home">
          <span class="brand-mark" aria-hidden="true">
            //
          </span>
          <span>RIKARD EKSTAM</span>
        </a>
        <span class="brand-status">
          IN PROGRESS <span aria-hidden="true">•••</span>
        </span>
        <nav aria-label="Main navigation">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={
                path === item.href || (item.href !== "/" && path.startsWith(item.href))
                  ? "page"
                  : undefined
              }
            >
              {item.label}
            </a>
          ))}
        </nav>
        <Stripes />
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-top">
        <Stripes />
        <p>Explore. Execute. Evolve.</p>
        <nav aria-label="Footer navigation">
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <a class="footer-github" href={site.github} aria-label="Rikard Ekstam on GitHub">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.61-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.95 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.28.1-2.66 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.81c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.41.1 2.66.64.7 1.03 1.59 1.03 2.69 0 3.85-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
          </svg>
        </a>
        {hasFeed && (
          <a class="footer-rss" href="/rss.xml" aria-label="RSS feed">
            RSS
          </a>
        )}
      </div>
      {site.designPreview && (
        <p class="design-disclosure">
          DESIGN PREVIEW{" "}
          <span>Project, company and update cards marked “Demo” are illustrative examples.</span>
        </p>
      )}
    </footer>
  </body>
</html>
