---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<!-- Decorative brand marks used in design-preview cards. -->
<svg viewBox="0 0 100 64" fill="currentColor" aria-hidden="true">
  {name === "star" && (
    <path d="M50 2c7 20 12 25 34 30-22 5-27 10-34 30-7-20-12-25-34-30C38 27 43 22 50 2Z" />
  )}
  {name === "tree" && (
    <>
      <path d="M45 37h11l-1 14 12 7H33l13-7Z" />
      <path d="M19 44C1 42 3 26 16 22c-3-13 14-20 24-13 10-13 28-9 31 2 18-2 28 12 21 23 12 14-13 21-25 12-12 8-22 7-31-1-6 4-12 4-17-1Z" />
    </>
  )}
  {name === "rhino" && (
    <path d="m8 48 6-18 16-12 25-4 19 8 7 14 7-5 2-17 7 23-5 12-16 3-5-8-5 16H54l-3-15-14 1-6 14H19l1-13-8 12H3l5-11Zm63-23-1-16 11 16-10 4Z" />
  )}
</svg>
